# SatQuery Phase 7 release-candidate settings
SATQUERY_CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
SATQUERY_ANALYSIS_TIMEOUT=900
SATQUERY_MAX_WORKERS=2
SATQUERY_MAX_QUEUE=6
SATQUERY_MAX_REQUEST_BYTES=2097152
